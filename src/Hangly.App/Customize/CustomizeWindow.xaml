<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hangly.App.Customize.CustomizeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Hangly.App.Customize"
    xmlns:controls="using:Hangly.App.Controls">

    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#09FFD700" Offset="0.0" />
                <GradientStop Color="#00000000" Offset="0.4" />
                <GradientStop Color="#088A2BE2" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <!--
                One tile. The tick is a border rather than a checkbox: a charm is chosen
                by clicking its picture, and a checkbox beside it would be a second way
                to do the same thing.
            -->
            <DataTemplate x:Key="CharmTemplate" x:DataType="local:CharmTile">
                <Grid
                    Width="92"
                    Height="112"
                    Padding="3"
                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneTime}"
                    ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneTime}">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{x:Bind Outline, Mode=OneWay}"
                        BorderThickness="2"
                        CornerRadius="14" />
                    <Button
                        Width="26"
                        Height="26"
                        Margin="0,3,3,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind FavouriteLabel, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnFavouriteClicked"
                        Content="{x:Bind FavouriteGlyph, Mode=OneWay}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Tag="{x:Bind Id, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind FavouriteLabel, Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center" Padding="4,2">
                        <Image
                            Width="52"
                            Height="52"
                            Stretch="Uniform"
                            Source="{x:Bind Image, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            MaxLines="2"
                            FontSize="11"
                            FontWeight="Medium"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DisplayName, Mode=OneTime}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- A collection, as a card. The artwork is three of its own charms
                 overlapping, which is what macOS does and what lets a collection be
                 added without anyone drawing a cover for it. -->
            <DataTemplate x:Key="CollectionTemplate" x:DataType="local:CollectionCard">
                <Grid
                    Width="222"
                    Margin="0,0,10,10"
                    Tapped="OnCollectionTapped"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="54" Height="54" Margin="0,0,10,0">
                        <Image
                            Width="40"
                            Height="40"
                            Margin="0,0,24,0"
                            Opacity="0.75"
                            Source="{x:Bind Third, Mode=OneTime}"
                            Stretch="Uniform"
                            Visibility="{x:Bind ThirdVisibility, Mode=OneTime}" />
                        <Image
                            Width="44"
                            Height="44"
                            Margin="24,0,0,0"
                            Opacity="0.9"
                            Source="{x:Bind Second, Mode=OneTime}"
                            Stretch="Uniform"
                            Visibility="{x:Bind SecondVisibility, Mode=OneTime}" />
                        <Image
                            Width="52"
                            Height="52"
                            Source="{x:Bind First, Mode=OneTime}"
                            Stretch="Uniform" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneTime}" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind CountLabel, Mode=OneTime}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Opacity="0.85"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Description, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TagTemplate" x:DataType="x:String">
                <Border
                    Margin="0,0,6,6"
                    Padding="10,4"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <TextBlock
                        Opacity="0.9"
                        FontSize="11"
                        FontWeight="Medium"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind}" />
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <!-- The pane is 300 rather than 200: it carries the charm's story now. -->
        <muxc:NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            SelectionChanged="OnSectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Library" Tag="charms" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Emoji2" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Create" Tag="create">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Appearance" Tag="appearance">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="About" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <!--
                The charm you are reading about, under the four page names.

                It used to hold a column of the Library to itself, whether or not anything
                was selected, and it scrolled inside a page that already scrolled. Here it
                has the tall empty block beneath the navigation that nothing was using, it
                updates as you pick charms, and it is the same panel on every page rather
                than something the Library owns.
            -->
            <muxc:NavigationView.PaneFooter>
                <Border
                    x:Name="DetailPanel"
                    Padding="16,12,16,16"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel
                            x:Name="DetailPlaceholder"
                            Margin="0,16,0,16"
                            Spacing="6"
                            Visibility="{x:Bind Detail.PlaceholderVisibility, Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Opacity="0.5"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Pick a charm"
                                TextAlignment="Center" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Opacity="0.4"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Its story shows up here."
                                TextAlignment="Center" />
                        </StackPanel>
                            <ScrollViewer Visibility="{x:Bind Detail.PanelVisibility, Mode=OneWay}">
                                <StackPanel Spacing="12">
                                    <!--
                                        Smaller than it was. At two hundred points the
                                        preview was the tallest thing in the sidebar and
                                        pushed the charm's own description below the fold,
                                        which is the wrong way round: the picture is
                                        already on the rope and in the grid, and the words
                                        are the only place the charm is explained.
                                    -->
                                    <Border
                                        Height="132"
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <Image
                                            AutomationProperties.AutomationId="DetailImage"
                                            Source="{x:Bind Detail.Image, Mode=OneWay}"
                                            Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            AutomationProperties.AutomationId="DetailName"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Detail.DisplayName, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="DetailRegion"
                                            CharacterSpacing="60"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Opacity="0.55"
                                            Text="{x:Bind Detail.Region, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind Detail.RegionVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="DetailCategory"
                                            Margin="0,2,0,0"
                                            Opacity="0.75"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail.Category, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind Detail.CategoryVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock
                                        AutomationProperties.AutomationId="DetailDescription"
                                        Opacity="0.85"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Detail.Description, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <ItemsControl
                                        AutomationProperties.AutomationId="DetailTags"
                                        ItemTemplate="{StaticResource TagTemplate}"
                                        ItemsSource="{x:Bind Detail.Tags, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <muxc:ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Border
                                        Margin="0,4,0,0"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="14"
                                            Glyph="{x:Bind Detail.RopeGlyph, Mode=OneWay}"
                                            Opacity="0.8" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="DetailRopeState"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Detail.RopeLabel, Mode=OneWay}" />
                                    </StackPanel>

                                    <Button
                                        x:Name="DetailFavourite"
                                        AutomationProperties.AutomationId="DetailFavourite"
                                        Click="OnDetailFavouriteClicked"
                                        HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="{x:Bind Detail.FavouriteGlyph, Mode=OneWay}" />
                                            <TextBlock Text="Favourite" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="DetailDeleteButton"
                                        AutomationProperties.AutomationId="DetailDeleteButton"
                                        Click="OnDetailDeleteClicked"
                                        Visibility="{x:Bind Detail.DeleteVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" Foreground="#E05555" />
                                            <TextBlock Text="Delete Charm" Foreground="#E05555" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                    </Grid>
                </Border>
            </muxc:NavigationView.PaneFooter>

            <Grid>
                <!-- Library -->
                <!--
                    Browsing is the point of this page, so browsing gets the room.

                    It did not, and testers said so: the detail panel held a fixed column
                    whether or not anything was selected, and above the charms sat the
                    title, the cord summary, the one-two-three picker, the places on the
                    rope and a size slider — about three hundred and eighty points of
                    controls between the window's top edge and the first charm, on an
                    eight-hundred-point window. Three rows of charms were visible where
                    there was room for six.

                    Everything about *the rope you have* now lives in the sidebar, which
                    was mostly empty, and everything about *charms you might want* has the
                    rest. The names are unchanged, so the code behind this did not move.
                -->
                <Grid x:Name="CharmsPage" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="278" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The detail panel. It follows the selection and never drives it:
                        macOS documents the rule as "the detail pane, which always shows
                        the selection", so picking a charm changes the rope and this
                        reports what changed rather than offering a second way to do it.
                    -->
                    <!--
                        What is on the cord: how many places, which one is chosen, and how
                        big it is. The charm's own story is not here any more — it is in
                        the navigation pane, where there was a tall empty block under the
                        four page names and nothing using it.
                    -->
                    <Border
                        Padding="20,16,20,20"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- What is on the rope now, and how many places there are. -->
                        <StackPanel Margin="0,0,0,16" Spacing="10">
                            <TextBlock
                                x:Name="CordSummary"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="On the cord" />
                            <muxc:RadioButtons
                                x:Name="CountChoice"
                                Header="Charms on the cord"
                                MaxColumns="3"
                                SelectionChanged="OnCountChanged">
                                <x:String>1</x:String>
                                <x:String>2</x:String>
                                <x:String>3</x:String>
                            </muxc:RadioButtons>
                            <!--
                                The places on the rope. A ListView rather than a row of
                                buttons because reordering is a drag on macOS, and a ListView
                                is the one WinUI control that does drag-reorder without the
                                drop logic being written here.
                            -->
                            <muxc:ListView
                                x:Name="SlotList"
                                Padding="0"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                AllowDrop="True"
                                AutomationProperties.Name="Charms on the cord, drag to reorder"
                                CanDragItems="True"
                                CanReorderItems="True"
                                IsItemClickEnabled="True"
                                ItemClick="OnSlotItemClicked"
                                ReorderMode="Enabled"
                                SelectionMode="Single">
                                <!--
                                    Down the column, not across it.

                                    Three places laid out horizontally at 96 points each
                                    need 288 plus padding, and the column they sit in is
                                    about 275 — so the third was cut off the right-hand
                                    edge with no way to reach it. Reported as "the third
                                    charm is hidden", and it was.

                                    A vertical list cannot run out of width. Three places
                                    fit at any window size and any scaling, the order
                                    reads the way the cord does — top of the list is top
                                    of the rope — and a name has room to be read rather
                                    than trimmed to "Nazar bonc…".
                                -->
                                <muxc:ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <muxc:ItemsStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </muxc:ListView.ItemsPanel>
                                <muxc:ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:SlotTile">
                                        <Border
                                            Margin="0,2,0,5"
                                            Padding="10,8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12">
                                                <Image
                                                    Width="38"
                                                    Height="38"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind Image, Mode=OneWay}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    MaxLines="1"
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </muxc:ListView.ItemTemplate>
                            </muxc:ListView>

                            <!--
                                Explicit move controls beside the drag.

                                macOS reorders by dragging and so does this, but a drag is the
                                only way it offers, and a drag cannot be done from the keyboard
                                or verified by a test. These buttons do the same thing through
                                the same path, which is what makes reordering something this
                                build can promise rather than hope for.
                            -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="MoveUpButton"
                                    AutomationProperties.AutomationId="MoveUpButton"
                                    AutomationProperties.Name="Move this charm up the cord"
                                    Click="OnMoveSlotUp"
                                    Content="Move up" />
                                <Button
                                    x:Name="MoveDownButton"
                                    AutomationProperties.AutomationId="MoveDownButton"
                                    AutomationProperties.Name="Move this charm down the cord"
                                    Click="OnMoveSlotDown"
                                    Content="Move down" />
                            </StackPanel>

                            <!-- The chosen place's own size: a trim against the master
                                 slider, not a second copy of it. -->
                            <StackPanel x:Name="SlotSizePanel" Spacing="2">
                                <TextBlock
                                    x:Name="SlotSizeLabel"
                                    AutomationProperties.AutomationId="SlotSizeLabel"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <Slider
                                    x:Name="SlotSizeSlider"
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="SlotSizeSlider"
                                    AutomationProperties.Name="Size of the chosen charm"
                                    LargeChange="0.1"
                                    SmallChange="0.05"
                                    StepFrequency="0.05"
                                    ValueChanged="OnSlotSizeChanged" />
                            </StackPanel>
                        </StackPanel>
                      </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1" Margin="24,16,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        Charms or ropes, as one switch. macOS puts the same two words at
                        the top of its library and this build had no equivalent at all:
                        ropes were on the Appearance page, two clicks away and in a
                        different room from the thing they hang.
                    -->
                    <!--
                        The switch sits beside the title rather than at the far right of
                        the window, and that is not only taste: the charm hangs from the
                        top right corner of the screen by default and draws over whatever
                        is under it, so anything in that corner of this window is behind a
                        charm some of the time.
                    -->
                    <Grid Margin="0,0,0,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="Library" />
                        <Border
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="2">
                            <muxc:ListView
                                x:Name="BrowseMode"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="BrowseMode"
                                AutomationProperties.Name="Browse charms or ropes"
                                SelectionChanged="OnBrowseModeChanged"
                                SelectionMode="Single">
                                <muxc:ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <muxc:ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </muxc:ListView.ItemsPanel>
                                <muxc:ListViewItem CornerRadius="14" Height="30" Padding="12,0" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Charms" VerticalAlignment="Center" />
                                    </StackPanel>
                                </muxc:ListViewItem>
                                <muxc:ListViewItem CornerRadius="14" Height="30" Padding="12,0" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEB42;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Ropes" VerticalAlignment="Center" />
                                    </StackPanel>
                                </muxc:ListViewItem>
                            </muxc:ListView>
                        </Border>
                    </Grid>

                    <!-- Search and the chips. A category is a filter, and a filter is one
                         click that leaves the charms where they are. -->
                    <StackPanel x:Name="CharmTools" Grid.Row="1" Margin="0,0,0,10" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <AutoSuggestBox
                                x:Name="SearchBox"
                                Width="300"
                                AutomationProperties.Name="Search charms"
                                PlaceholderText="Search charms, places, materials"
                                QueryIcon="Find"
                                TextChanged="OnSearchChanged" />
                            <Button
                                x:Name="ImportButton"
                                AutomationProperties.Name="Import a charm"
                                Click="OnImportClicked"
                                Content="Import Charm…" />
                            <Button
                                x:Name="DeleteButton"
                                AutomationProperties.Name="Delete the selected imported charm"
                                Click="OnDeleteImportClicked"
                                Content="Delete"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="ImportMessage"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ImportMessage"
                                MaxWidth="480"
                                Opacity="0.8"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <controls:WrapPanel x:Name="FilterChips" HorizontalSpacing="8" VerticalSpacing="8" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="ResultsScroller">
                            <StackPanel>
                            <!-- Collections, as cards. Shown only when nothing is
                                 filtering the view: they are a way in, and a way in is
                                 noise once you have already narrowed to six charms. -->
                            <ItemsControl
                                x:Name="Collections"
                                Margin="0,0,0,10"
                                ItemTemplate="{StaticResource CollectionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <muxc:ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="Packs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:CharmGroup">
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="{x:Bind Name, Mode=OneTime}" />
                                            <GridView
                                                IsItemClickEnabled="True"
                                                ItemClick="OnCharmClicked"
                                                ItemTemplate="{StaticResource CharmTemplate}"
                                                ItemsSource="{x:Bind Charms, Mode=OneTime}"
                                                SelectionMode="None"
                                                TabNavigation="Local" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!--
                            Ropes. Five of them, each a different set of solver values
                            rather than a different picture, which is why the description
                            talks about how it moves and not what it looks like.
                        -->
                        <ScrollViewer x:Name="RopesScroller" Visibility="Collapsed">
                            <muxc:ListView
                                x:Name="RopeList"
                                AutomationProperties.AutomationId="RopeList"
                                AutomationProperties.Name="Rope styles"
                                IsItemClickEnabled="True"
                                ItemClick="OnRopeListClicked"
                                SelectionMode="Single">
                                <muxc:ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RopeChoiceItem">
                                        <Border
                                            Margin="0,4,12,6"
                                            Padding="16,12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="38"
                                                    Height="38"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="19"
                                                    VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE71B;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Name, Mode=OneTime}" />
                                                    <TextBlock
                                                        MaxWidth="600"
                                                        Opacity="0.75"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Description, Mode=OneTime}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </muxc:ListView.ItemTemplate>
                            </muxc:ListView>
                        </ScrollViewer>

                        <!-- Empty states. Which one depends on why there is nothing. -->
                        <StackPanel
                            x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="EmptyTitle"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="EmptyDetail"
                                HorizontalAlignment="Center"
                                MaxWidth="360"
                                Opacity="0.7"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Grid>

                <!--
                    Create. The smallest thing that turns a picture into a charm: pick a
                    file, see it, name it, hang it. Everything it does not offer —
                    cutting out a background, moving the knot, editing the beads — is
                    deliberately absent rather than unfinished.
                -->
                <ScrollViewer x:Name="CreatePage" Visibility="Collapsed">
                    <StackPanel Margin="24,16,24,24" MaxWidth="640" HorizontalAlignment="Center" Spacing="16">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Create" />
                        <TextBlock
                            Opacity="0.8"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Turn a picture into a charm. PNG, JPG or SVG."
                            TextWrapping="Wrap" />

                        <Button
                            x:Name="CreateChooseButton"
                            AutomationProperties.AutomationId="CreateChooseButton"
                            Click="OnCreateChoose"
                            Content="Choose a picture…" />

                        <Border
                            x:Name="CreatePreviewFrame"
                            Height="260"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <Image
                                x:Name="CreatePreview"
                                AutomationProperties.AutomationId="CreatePreview"
                                Stretch="Uniform" />
                        </Border>

                        <StackPanel x:Name="CreateDetails" Spacing="6" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
                            <TextBox
                                x:Name="CreateNameBox"
                                MaxWidth="320"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="CreateNameBox"
                                AutomationProperties.Name="Charm name"
                                MaxLength="40"
                                TextChanged="OnCreateNameChanged" />
                            <TextBlock
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="It joins the Custom collection in your Library." />

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="CreateAndHangButton"
                                    AutomationProperties.AutomationId="CreateAndHangButton"
                                    Click="OnCreateAndHang"
                                    Content="Create &amp; Hang"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="CreateAndSaveButton"
                                    AutomationProperties.AutomationId="CreateAndSaveButton"
                                    Click="OnCreateAndSave"
                                    Content="Create &amp; Save" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            x:Name="CreateMessage"
                            AutomationProperties.AutomationId="CreateMessage"
                            MaxWidth="560"
                            Opacity="0.85"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Appearance -->
                <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed">
                    <StackPanel Margin="28,20,28,32" MaxWidth="720" HorizontalAlignment="Center" Spacing="20">
                        <!-- Page Header -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Appearance &amp; Behavior" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.7"
                                Text="Customize charm scale, rope reach, illumination effects, and desktop placement." />
                        </StackPanel>

                        <!-- Card 1: Display & Position -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="38" Height="38"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Display &amp; Position" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                        <TextBlock Text="Choose display monitor and desktop anchor alignment" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

                                <!-- Monitor Selection -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Target Display" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                        <TextBlock Text="The screen Hangly hangs from" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                    </StackPanel>
                                    <ComboBox
                                        x:Name="AnchorChoice"
                                        Grid.Column="1"
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        SelectionChanged="OnAnchorChanged" />
                                </Grid>

                                <!-- Quick Position Presets -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Quick Presets" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Opacity="0.8" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="PresetLeftButton"
                                            HorizontalAlignment="Stretch"
                                            Click="OnPresetLeftClicked"
                                            Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                <TextBlock Text="Top Left" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="PresetCenterButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Click="OnPresetCenterClicked"
                                            Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                                <TextBlock Text="Top Center" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="PresetRightButton"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            Click="OnPresetRightClicked"
                                            Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                <FontIcon Glyph="&#xE898;" FontSize="13" />
                                                <TextBlock Text="Top Right" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Continuous Horizontal Position Slider -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="PositionLabel" Text="Horizontal position" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                            <TextBlock Text="Freeform horizontal adjustment across the top edge" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                        </StackPanel>
                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2">
                                            <TextBlock x:Name="PositionValueBadge" Text="50%" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="PositionSlider" ValueChanged="OnPositionChanged" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Drag Knot Tip -->
                                <Border
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Opacity="0.85"
                                            Text="Tip: Drag the knot at the very top of the cord directly on your desktop to position Hangly anywhere along your display."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Size & Reach -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="38" Height="38"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Dimensions &amp; Reach" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                        <TextBlock Text="Scale of the hanging charms and cord length" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

                                <!-- Charm Size Slider -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="SizeLabel" Text="Charm size" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                            <TextBlock Text="Display scale for charms (0.5x to 2.0x)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                        </StackPanel>
                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2">
                                            <TextBlock x:Name="SizeValueBadge" Text="100%" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SizeSlider" ValueChanged="OnSizeChanged" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Rope Length Slider -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="LengthLabel" Text="Rope length" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                            <TextBlock Text="Vertical reach and suspension length of the cord" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                        </StackPanel>
                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2">
                                            <TextBlock x:Name="LengthValueBadge" Text="100%" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="LengthSlider" ValueChanged="OnLengthChanged" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Luminance & Effects -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="38" Height="38"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEA3B;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Luminance &amp; Visual Effects" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                        <TextBlock Text="Multi-tonal ambient glow and wallpaper blending" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

                                <!-- Charm Glow Slider -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="GlowLabel" Text="Charm radiant aura" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                            <TextBlock Text="Radiant ambient glow emitted around charms (0% to 200%)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                        </StackPanel>
                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2">
                                            <TextBlock x:Name="GlowValueBadge" Text="100%" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="GlowSlider" ValueChanged="OnGlowChanged" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Opacity Slider -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="OpacityLabel" Text="Overlay opacity" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                            <TextBlock Text="Overall transparency blending with desktop wallpaper" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                        </StackPanel>
                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2">
                                            <TextBlock x:Name="OpacityValueBadge" Text="100%" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="OpacitySlider" ValueChanged="OnOpacityChanged" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Behavior & Actions -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="38" Height="38"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Behavior &amp; System" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                        <TextBlock Text="Desktop overlay state and system startup" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

                                <!-- Show Hangly Toggle -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Show Hangly on Desktop" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                        <TextBlock Text="Render charms and physics rope actively on screen" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ShowToggle" Grid.Column="1" Toggled="OnShowToggled" Margin="0" />
                                </Grid>

                                <!-- Launch at login Toggle -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Launch at Windows Startup" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                        <TextBlock Text="Hang charms automatically whenever you log into Windows" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LoginToggle" Grid.Column="1" Toggled="OnLoginToggled" Margin="0" />
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

                                <!-- Restore Defaults Action -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Restore Appearance Defaults" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                        <TextBlock Text="Revert size, length, glow, and position to default settings" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ResetButton"
                                        Grid.Column="1"
                                        Click="OnReset"
                                        Content="Restore Defaults"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel Margin="28,20,28,32" MaxWidth="720" HorizontalAlignment="Center" Spacing="20">
                        <!-- Hero Branding Card -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="72" Height="72"
                                        CornerRadius="14"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Image
                                            x:Name="AppIcon"
                                            Width="56"
                                            Height="56"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Hangly" FontWeight="Bold" FontSize="26" />
                                            <Border
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="VersionLine"
                                                    Foreground="White"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="v0.9.0" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="CopyrightLine"
                                            Opacity="0.6"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Opacity="0.85"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="An artisanal interactive desktop ornament engineered with authentic physics and dynamic lighting."
                                            TextWrapping="Wrap"
                                            Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <HyperlinkButton x:Name="WebsiteLink" Content="🌐 Website" />
                                    <HyperlinkButton x:Name="GitHubLink" Content="💻 GitHub" />
                                    <HyperlinkButton x:Name="ReleaseNotesLink" Content="📋 Release Notes" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Milestones Showcase Grid -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Milestones" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Swings -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                        <TextBlock
                                            x:Name="StatSwings"
                                            AutomationProperties.AutomationId="StatSwings"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center" />
                                        <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" Text="Swings Survived" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Charms -->
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                        <TextBlock
                                            x:Name="StatCharms"
                                            AutomationProperties.AutomationId="StatCharms"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center" />
                                        <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" Text="Charms Hung" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Launches -->
                                <Border
                                    Grid.Column="2"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                        <TextBlock
                                            x:Name="StatLaunches"
                                            AutomationProperties.AutomationId="StatLaunches"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center" />
                                        <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" Text="App Launches" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Secrets -->
                                <Border
                                    Grid.Column="3"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE728;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                        <TextBlock
                                            x:Name="StatSecrets"
                                            AutomationProperties.AutomationId="StatSecrets"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center" />
                                        <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" Text="Secrets Found" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Secret Revelation Card -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Hangly Secrets" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                        <TextBlock Text="Discover hidden lore and give the cord a playful push" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    </StackPanel>
                                    <Button
                                        x:Name="SecretButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="SecretButton"
                                        AutomationProperties.HelpText="Reveals one of the app's secrets, and pushes the rope"
                                        Click="OnSecretClicked"
                                        Content="✨ Reveal a Secret"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                                <Border
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                    <TextBlock
                                        x:Name="SecretText"
                                        AutomationProperties.AutomationId="SecretText"
                                        Opacity="0.85"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="No secret revealed yet. Click the button above to discover one!"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Support Card -->
                        <Border
                            x:Name="CreatorCard"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Support the Creator" FontSize="15" />
                                <TextBlock Opacity="0.8" Style="{StaticResource BodyTextBlockStyle}" Text="Thank you for using Hangly! If you enjoy having charms dancing on your desktop, consider supporting its development." TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="CoffeeButton"
                                        AutomationProperties.AutomationId="CoffeeButton"
                                        Click="OnCoffeeClicked"
                                        Content="☕ Buy Creator a Coffee"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <HyperlinkButton x:Name="InstagramLink" Click="OnInstagramClicked" Content="📸 Instagram" />
                                    <HyperlinkButton x:Name="SuggestLink" Click="OnSuggestClicked" Content="💡 Suggest a Charm" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Updates Card -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Updates &amp; Help" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="CheckUpdateButton"
                                        AutomationProperties.AutomationId="CheckUpdateButton"
                                        Click="OnCheckForUpdates"
                                        Content="Check for Updates" />
                                    <Button
                                        x:Name="InstallUpdateButton"
                                        AutomationProperties.AutomationId="InstallUpdateButton"
                                        Click="OnInstallUpdate"
                                        Content="Install and Restart"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="ShowWelcomeButton"
                                        AutomationProperties.AutomationId="ShowWelcomeButton"
                                        Click="OnShowWelcomeClicked"
                                        Content="Show Welcome Guide" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="UpdateMessage"
                                    AutomationProperties.AutomationId="UpdateMessage"
                                    Opacity="0.8"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <Border
                                    x:Name="UpdateNotesPanel"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            x:Name="UpdateNotes"
                                            AutomationProperties.AutomationId="UpdateNotes"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Anonymous Analytics Expander -->
                        <muxc:Expander
                            x:Name="AnalyticsSection"
                            HorizontalAlignment="Stretch"
                            Header="Anonymous Diagnostics &amp; Telemetry">
                            <StackPanel Margin="0,8,0,0" Spacing="12">
                                <ToggleSwitch
                                    x:Name="AnalyticsToggle"
                                    Header="Share anonymous analytics"
                                    Toggled="OnAnalyticsToggled" />
                                <TextBlock
                                    Opacity="0.75"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    Text="Counts which features are used so Hangly can be continuously refined. Never tracks your name, your files, or where your charm sits. Switching it off stops collection immediately and purges local identifiers." />

                                <Grid ColumnSpacing="16" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Opacity="0.7" Text="Sharing" />
                                    <TextBlock x:Name="AnalyticsState" Grid.Column="1" />

                                    <TextBlock Grid.Row="1" Opacity="0.7" Text="Destination" />
                                    <TextBlock x:Name="AnalyticsEndpoint" Grid.Row="1" Grid.Column="1" />

                                    <TextBlock Grid.Row="2" Opacity="0.7" Text="Installation" />
                                    <TextBlock
                                        x:Name="AnalyticsIdentifier"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True" />

                                    <TextBlock Grid.Row="3" Opacity="0.7" Text="Last event" />
                                    <TextBlock x:Name="AnalyticsLastEvent" Grid.Row="3" Grid.Column="1" />

                                    <TextBlock Grid.Row="4" Opacity="0.7" Text="Events sent" />
                                    <TextBlock x:Name="AnalyticsSentCount" Grid.Row="4" Grid.Column="1" />

                                    <TextBlock Grid.Row="5" Opacity="0.7" Text="Your name" />
                                    <TextBlock
                                        x:Name="AnalyticsUserName"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="AnalyticsUserName" />
                                </Grid>

                                <!-- Exactly what leaves the machine, listed rather than
                                     described. A privacy claim nobody can check is a
                                     promise rather than a fact. -->
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Every event carries these and nothing else:" />
                                <TextBlock
                                    x:Name="AnalyticsFields"
                                    AutomationProperties.AutomationId="AnalyticsFields"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Opacity="0.85"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxWidth="560"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Never your files, their names, their contents, the folders they came from, your clipboard, your email, or your Windows account name."
                                    TextWrapping="Wrap" />

                                <Button x:Name="RefreshAnalytics" Click="OnRefreshAnalytics" Content="Refresh" />
                            </StackPanel>
                        </muxc:Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>

</Window>
