<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Hangly.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Hangly's brand palette, lifted from the mobile app's HanglyTheme
                (src/mobile/lib/app/theme.dart, dark theme) and applied here as overrides
                of the Fluent "alias" tier that Generic.xaml's control templates already
                bind to via ThemeResource — so every existing card, button, toggle and
                divider in CustomizeWindow.xaml re-colors without any control needing its
                own Background/Foreground restated. Keys left undefined here still fall
                through to XamlControlsResources' own Dark dictionary above.

                RequestedTheme is pinned to Dark (see the Application element) because the
                desktop app has no light/dark switch of its own to hang a second palette
                off of, unlike mobile's theme toggle — mobile's own default is dark too.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Accent = mobile's HanglyTheme.primary (Hangly Gold). Light/Dark
                         steps are a plain tint/shade ramp off that one color; mobile has
                         no equivalent ramp of its own to copy. -->
                    <Color x:Key="SystemAccentColor">#FFD700</Color>
                    <Color x:Key="SystemAccentColorLight1">#FFDE33</Color>
                    <Color x:Key="SystemAccentColorLight2">#FFE666</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFEE99</Color>
                    <Color x:Key="SystemAccentColorDark1">#E6C200</Color>
                    <Color x:Key="SystemAccentColorDark2">#CCAD00</Color>
                    <Color x:Key="SystemAccentColorDark3">#997F00</Color>

                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFD700" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6C200" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCAD00" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD700" />

                    <!-- HanglyTheme.background -->
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0B0F19" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#151D2F" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#1E293B" />

                    <!-- HanglyTheme.surface / surfaceElevated, for every card Border in
                         CustomizeWindow.xaml -->
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#151D2F" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#334155" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#334155" />

                    <!-- HanglyTheme.border, for card outlines and the divider rules
                         between Appearance/About sections -->
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#334155" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#334155" />
                    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#475569" />

                    <!-- Button/TextBox/ComboBox/Slider default fills -->
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#151D2F" />
                    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1E293B" />

                    <!-- HanglyTheme.textPrimary / textSecondary -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#94A3B8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Catches the handful of bare, unstyled TextBlocks (no explicit Style=
                "{StaticResource ...TextBlockStyle}") that would otherwise sit outside the
                ContentControlThemeFontFamily override App.xaml.cs installs at startup —
                every Control and every Fluent typographic ramp style already reads
                FontFamily from that same key, so this is only a backstop, not a second
                place the font is set.
            -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
